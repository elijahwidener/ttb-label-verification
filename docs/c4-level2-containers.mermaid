flowchart TD
    submitter([" Importer / Submitter"])
    agent([" Compliance Agent"])
    anthropic([" Anthropic API\nClaude Vision"])

    subgraph ttb["TTB Label Verification System"]
        web[" Web Application\nReact + Vite"]
        api[" API\nAzure Functions (Python)"]
        extraction[" Extraction & Validation Engine\nPython Modules"]
        blob[(" Blob Storage\nAzure Blob Storage")]
        db[(" PostgreSQL\nAzure Database for PostgreSQL")]
    end

    submitter -- "Submit Application" --> web
    agent -- "Review Applications" --> web
    web -- "HTTPS / JSON" --> api
    api -- "Process Submission" --> extraction
    extraction -- "Extract Label Data" --> anthropic
    api -- "Query Queue & Decisions" --> db
    extraction -- "Store Results" --> db
    api -- "Store / Retrieve Images" --> blob
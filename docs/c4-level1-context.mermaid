    title System Context — TTB Label Verification Prototype
    Person(submitter, "Importer / Submitter", "Uploads label applications, one at a time or in bulk. Receives immediate image-quality feedback.")
    Person(agent, "Compliance Agent", "Reviews pre-processed applications and approves or rejects.")

flowchart TD
    submitter([" Importer / Submitter\nUploads label applications"])
    agent([" Compliance Agent\nReviews & approves / rejects"])
    ttb[" TTB Label Verification System\nAI extraction + rule-based validation"]
    anthropic([" Anthropic API\nClaude vision model"])

